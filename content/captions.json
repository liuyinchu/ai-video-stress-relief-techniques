[
  {
    "start": 0.4,
    "end": 3.5,
    "text": "压力上来，先别急着说服自己"
  },
  {
    "start": 3.5,
    "end": 4.9,
    "text": "给身体一点缓冲"
  },
  {
    "start": 5.4,
    "end": 8.0,
    "text": "鼻子轻轻吸气"
  },
  {
    "start": 8.0,
    "end": 8.7,
    "text": "再补一小口"
  },
  {
    "start": 8.7,
    "end": 11.2,
    "text": "嘴巴慢慢呼出"
  },
  {
    "start": 11.2,
    "end": 16.6,
    "text": "不要用力，头晕就停"
  },
  {
    "start": 17.4,
    "end": 20.4,
    "text": "用凉毛巾轻敷脸颊"
  },
  {
    "start": 20.4,
    "end": 22.7,
    "text": "保持自然呼吸"
  },
  {
    "start": 23.4,
    "end": 27.7,
    "text": "轻揉耳廓，以舒服为准"
  },
  {
    "start": 28.4,
    "end": 32.4,
    "text": "轻轻抖动手脚，放松肩膀"
  },
  {
    "start": 32.4,
    "end": 33.7,
    "text": "别甩头"
  },
  {
    "start": 34.4,
    "end": 37.0,
    "text": "把烦心事写下来"
  },
  {
    "start": 37.0,
    "end": 41.7,
    "text": "揉成纸团，再丢掉"
  },
  {
    "start": 42.4,
    "end": 45.6,
    "text": "看一会儿树叶、云朵"
  },
  {
    "start": 45.6,
    "end": 48.7,
    "text": "让目光慢下来"
  },
  {
    "start": 49.4,
    "end": 52.0,
    "text": "只整理桌面一小块"
  },
  {
    "start": 52.0,
    "end": 54.7,
    "text": "让眼前恢复一点秩序"
  },
  {
    "start": 55.5,
    "end": 58.3,
    "text": "不必全做，挑一个就好"
  },
  {
    "start": 58.3,
    "end": 59.5,
    "text": "先松一口气"
  },
  {
    "start": 59.5,
    "end": 61.5,
    "text": "再处理眼前的事"
  }
]